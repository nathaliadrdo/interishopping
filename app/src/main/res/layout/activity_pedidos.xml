<?xml version="1.0" encoding="utf-8"?>
<!-- Tela Pedidos: cabeçalho verde + busca, filtros por status, lista de cards e botão flutuante "novo pedido" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nevoa"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/TituloCabecalho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pedidos" />

        <EditText
            android:id="@+id/etBusca"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:autofillHints="name"
            android:background="@drawable/bg_search"
            android:hint="@string/hint_busca_pedido"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
        android:paddingEnd="16dp"
            android:textColor="@color/tinta_fixa"
            android:textColorHint="#6B7872"
            android:textSize="15sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
        android:paddingEnd="16dp"
            android:paddingTop="8dp"
        android:paddingBottom="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filtro_todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendente"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_pendente" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProducao"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_producao" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipACaminho"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_a_caminho" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFinalizado"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_finalizado" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp" />

        <TextView
            android:id="@+id/tvVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/msg_sem_pedidos"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabNovoPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/btn_novo_pedido"
            app:backgroundTint="@color/verde_pinheiro"
            android:textColor="@color/sobre_verde"
            app:icon="@drawable/ic_mais"
            app:iconTint="@color/sobre_verde" />
    </FrameLayout>

    <include layout="@layout/include_nav" />
</LinearLayout>
